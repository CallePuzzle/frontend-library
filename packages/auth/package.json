{
  "name": "@callepuzzle/auth",
  "version": "0.0.0",
  "description": "Wrapper de better-auth para las apps SvelteKit de CallePuzzle",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/CallePuzzle/storybook-svelte.git",
    "directory": "packages/auth"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com",
    "access": "public"
  },
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist",
    "!dist/**/*.test.*",
    "!dist/**/*.spec.*"
  ],
  "exports": {
    "./client": {
      "types": "./dist/client.d.ts",
      "import": "./dist/client.js",
      "default": "./dist/client.js"
    },
    "./server": {
      "types": "./dist/server.d.ts",
      "import": "./dist/server.js",
      "default": "./dist/server.js"
    },
    "./hooks": {
      "types": "./dist/hooks.d.ts",
      "import": "./dist/hooks.js",
      "default": "./dist/hooks.js"
    },
    "./sender": {
      "types": "./dist/sender.d.ts",
      "import": "./dist/sender.js",
      "default": "./dist/sender.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "dev": "tsup --watch",
    "build": "tsup",
    "lint": "eslint . --max-warnings 0",
    "prepack": "bun run build && publint",
    "check-publish": "bun run build && publint && attw --pack . --profile esm-only"
  },
  "dependencies": {
    "nodemailer": "^7.0.5"
  },
  "peerDependencies": {
    "@sveltejs/kit": "^2.27.0",
    "better-auth": "^1.3.4"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.2",
    "@callepuzzle/typescript-config": "*",
    "@repo/eslint-config": "*",
    "@sveltejs/kit": "^2.27.0",
    "@types/nodemailer": "^6.4.17",
    "better-auth": "^1.3.4",
    "eslint": "^9.32.0",
    "publint": "^0.3.12",
    "tsup": "^8.0.0",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4"
  }
}
