{
	"name": "@callepuzzle/svelte-ui",
	"version": "2.0.0",
	"description": "Componentes Svelte 5 de la librería de front de CallePuzzle",
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/CallePuzzle/storybook-svelte.git",
		"directory": "packages/ui"
	},
	"publishConfig": {
		"registry": "https://npm.pkg.github.com",
		"access": "public"
	},
	"type": "module",
	"sideEffects": [
		"**/*.css"
	],
	"keywords": [
		"svelte",
		"sveltekit",
		"daisyui",
		"ui"
	],
	"scripts": {
		"dev": "svelte-kit sync && svelte-package --watch --input=src",
		"build": "svelte-kit sync && svelte-package --input=src",
		"prepare": "svelte-kit sync || echo ''",
		"prepack": "bun run build && publint",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"check-types": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"lint": "oxlint --config ../../.oxlintrc.json . && eslint .",
		"test": "vitest run",
		"test:watch": "vitest",
		"storybook": "storybook dev -p 6006 --no-open",
		"build-storybook": "storybook build",
		"check-publish": "bun run build && publint && attw --pack . --profile esm-only --ignore-rules internal-resolution-error --exclude-entrypoints ./styles.css"
	},
	"files": [
		"dist",
		"!dist/**/*.test.*",
		"!dist/**/*.spec.*"
	],
	"svelte": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"svelte": "./dist/index.js",
			"default": "./dist/index.js"
		},
		"./otp": {
			"types": "./dist/otp.d.ts",
			"svelte": "./dist/otp.js",
			"default": "./dist/otp.js"
		},
		"./styles.css": "./dist/styles/index.css",
		"./package.json": "./package.json"
	},
	"peerDependencies": {
		"@lucide/svelte": "^0.488.0 || ^1.0.0",
		"@sveltejs/kit": "^3.0.0",
		"bits-ui": "^2.19.0",
		"daisyui": "^5.0.50",
		"formsnap": "^2.1.0",
		"svelte": "^5.57.1",
		"sveltekit-superforms": "^3.0.0",
		"tailwindcss": "^4.1.11",
		"zod": "^3.25.0 || ^4.0.0"
	},
	"peerDependenciesMeta": {
		"bits-ui": {
			"optional": true
		}
	},
	"dependencies": {
		"@callepuzzle/core": "^1.0.1",
		"clsx": "^2.1.1",
		"esm-env": "^1.2.2",
		"tailwind-merge": "^3.3.1"
	},
	"devDependencies": {
		"@arethetypeswrong/cli": "^0.18.2",
		"@callepuzzle/typescript-config": "*",
		"@chromatic-com/storybook": "^5.6.0",
		"@eslint/compat": "^1.3.1",
		"@eslint/js": "^9.32.0",
		"@lucide/svelte": "^0.488.0",
		"@playwright/test": "^1.62.1",
		"@storybook/addon-a11y": "^10.6.5",
		"@storybook/addon-docs": "^10.6.5",
		"@storybook/addon-svelte-csf": "^5.1.6",
		"@storybook/addon-vitest": "^10.6.5",
		"@storybook/svelte-vite": "^10.6.5",
		"@sveltejs/kit": "^3.1.1",
		"@sveltejs/package": "^2.5.8",
		"@sveltejs/vite-plugin-svelte": "^7.3.1",
		"@tailwindcss/forms": "^0.5.10",
		"@tailwindcss/typography": "^0.5.16",
		"@tailwindcss/vite": "^4.3.3",
		"@testing-library/jest-dom": "^6.6.4",
		"@types/node": "^22.17.0",
		"@vitest/browser": "^4.1.12",
		"@vitest/browser-playwright": "^4.1.12",
		"@vitest/coverage-v8": "^4.1.12",
		"bits-ui": "^2.20.3",
		"daisyui": "^5.0.50",
		"eslint": "^9.32.0",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-storybook": "^10.6.5",
		"eslint-plugin-svelte": "^3.23.1",
		"formsnap": "^2.1.0",
		"globals": "^16.3.0",
		"playwright": "^1.62.1",
		"prettier": "^3.6.2",
		"prettier-plugin-svelte": "^3.4.0",
		"prettier-plugin-tailwindcss": "^0.6.14",
		"publint": "^0.3.12",
		"storybook": "^10.6.5",
		"svelte": "^5.57.3",
		"svelte-check": "^4.7.8",
		"sveltekit-superforms": "^3.1.0",
		"tailwindcss": "^4.3.3",
		"typescript": "6.0.3",
		"typescript-eslint": "^8.72.1",
		"vite": "^8.0.12",
		"vitest": "^4.1.12",
		"vitest-browser-svelte": "^3.1.0",
		"zod": "^4.6.7"
	}
}
