{
  "name": "@callepuzzle/svelte-ui",
  "version": "0.0.0",
  "description": "Componentes Svelte 5 de la librería de front de CallePuzzle",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/CallePuzzle/storybook-svelte.git",
    "directory": "packages/ui"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com",
    "access": "public"
  },
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "keywords": [
    "svelte"
  ],
  "scripts": {
    "dev": "paraglide-js compile --project ./project.inlang --outdir ./src/paraglide && svelte-kit sync && svelte-package --watch --input=src",
    "build": "paraglide-js compile --project ./project.inlang --outdir ./src/paraglide && svelte-kit sync && svelte-package --input=src && rm -f dist/paraglide/.gitignore dist/paraglide/.prettierignore",
    "preview": "vite preview",
    "prepare": "svelte-kit sync || echo ''",
    "prepack": "bun run build && publint",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
    "format": "prettier --write .",
    "lint": "prettier --check . && eslint .",
    "test": "vitest",
    "storybook": "storybook dev -p 6006 --no-open",
    "build-storybook": "storybook build",
    "check-publish": "bun run build && publint && attw --pack . --profile esm-only --ignore-rules internal-resolution-error"
  },
  "files": [
    "dist",
    "!dist/**/*.test.*",
    "!dist/**/*.spec.*"
  ],
  "svelte": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "svelte": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "peerDependencies": {
    "svelte": "^5.36.12"
  },
  "dependencies": {
    "@callepuzzle/auth": "^0.0.0",
    "@callepuzzle/core": "^0.0.0",
    "@lucide/svelte": "^0.488.0",
    "formsnap": "^2.0.1",
    "sveltekit-superforms": "^2.27.1",
    "zod": "^3.25.76",
    "zod-to-json-schema": "^3.24.6"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.2",
    "@chromatic-com/storybook": "^4.1.0",
    "@eslint/compat": "^1.3.1",
    "@eslint/js": "^9.32.0",
    "@playwright/test": "^1.54.2",
    "@storybook/addon-a11y": "^9.1.0",
    "@storybook/addon-docs": "^9.1.0",
    "@storybook/addon-svelte-csf": "^5.0.7",
    "@storybook/addon-vitest": "^9.1.0",
    "@storybook/sveltekit": "^9.1.0",
    "@sveltejs/adapter-auto": "^6.0.1",
    "@sveltejs/kit": "^2.27.0",
    "@sveltejs/package": "^2.5.8",
    "@sveltejs/vite-plugin-svelte": "^6.1.0",
    "@tailwindcss/forms": "^0.5.10",
    "@tailwindcss/typography": "^0.5.16",
    "@tailwindcss/vite": "^4.1.11",
    "@testing-library/jest-dom": "^6.6.4",
    "@types/node": "^22.17.0",
    "@vitest/browser": "^3.2.4",
    "better-auth": "^1.3.4",
    "daisyui": "^5.0.50",
    "eslint": "^9.32.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-storybook": "^9.1.0",
    "eslint-plugin-svelte": "^3.11.0",
    "globals": "^16.3.0",
    "playwright": "^1.54.2",
    "prettier": "^3.6.2",
    "prettier-plugin-svelte": "^3.4.0",
    "prettier-plugin-tailwindcss": "^0.6.14",
    "publint": "^0.3.12",
    "storybook": "^9.1.0",
    "svelte": "^5.37.2",
    "svelte-check": "^4.3.0",
    "tailwindcss": "^4.1.11",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.38.0",
    "vite": "^7.0.6",
    "vitest": "^3.2.4",
    "vitest-browser-svelte": "^0.1.0"
  }
}
