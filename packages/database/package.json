{
  "name": "@repo/database",
  "version": "1.0.0",
  "exports": {
    ".": "./src/client.ts"
  },
  "scripts": {
    "db:generate": "prisma generate",
    "db:migrate:deploy": "prisma migrate deploy",
    "db:migrate:dev": "prisma migrate dev",
    "db:push": "prisma db push",
    "db:seed": "tsx src/seed.ts",
    "dev": "tsup src/* --watch",
    "format": "prisma format",
    "lint": "eslint . --max-warnings 0",
    "studio": "prisma studio",
    "better-auth:generate": "bunx @better-auth/cli@latest generate -y --config ../../demos/sveltekit/src/lib/server/auth.ts"
  },
  "dependencies": {
    "@prisma/adapter-libsql": "^6.12.0",
    "@prisma/client": "^6.12.0"
  },
  "devDependencies": {
    "@repo/eslint-config": "*",
    "@callepuzzle/typescript-config": "*",
    "eslint": "^8.57.0",
    "prisma": "^6.12.0",
    "rimraf": "^5.0.5",
    "tsup": "^8.0.2",
    "tsx": "4.19.1",
    "typescript": "5.5.4"
  },
  "private": true
}
