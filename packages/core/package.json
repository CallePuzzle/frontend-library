{
	"name": "@callepuzzle/core",
	"version": "1.0.0",
	"description": "Tipos, rutas y utilidades sin UI de la librería de front de CallePuzzle",
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/CallePuzzle/storybook-svelte.git",
		"directory": "packages/core"
	},
	"publishConfig": {
		"registry": "https://npm.pkg.github.com",
		"access": "public"
	},
	"type": "module",
	"sideEffects": false,
	"files": [
		"dist",
		"!dist/**/*.test.*",
		"!dist/**/*.spec.*"
	],
	"types": "./dist/index.d.ts",
	"main": "./dist/index.js",
	"module": "./dist/index.js",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js",
			"default": "./dist/index.js"
		},
		"./schema": {
			"types": "./dist/schema/index.d.ts",
			"import": "./dist/schema/index.js",
			"default": "./dist/schema/index.js"
		},
		"./package.json": "./package.json"
	},
	"scripts": {
		"dev": "tsup --watch",
		"build": "tsup",
		"check-types": "tsc --noEmit",
		"lint": "oxlint --config ../../.oxlintrc.json .",
		"test": "vitest run",
		"test:coverage": "vitest run --coverage",
		"test:watch": "vitest",
		"prepack": "bun run build && publint",
		"check-publish": "bun run build && publint && attw --pack . --profile esm-only"
	},
	"peerDependencies": {
		"svelte": "^5.36.0",
		"zod": "^3.25.0 || ^4.0.0"
	},
	"peerDependenciesMeta": {
		"svelte": {
			"optional": true
		},
		"zod": {
			"optional": true
		}
	},
	"devDependencies": {
		"@arethetypeswrong/cli": "^0.18.2",
		"@callepuzzle/typescript-config": "*",
		"@vitest/coverage-v8": "^4.1.11",
		"publint": "^0.3.12",
		"svelte": "^5.36.0",
		"tsup": "^8.0.0",
		"typescript": "5.9.2",
		"vitest": "^4.1.11",
		"zod": "^4.6.7"
	}
}
