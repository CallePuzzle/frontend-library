{
  "name": "@callepuzzle/core",
  "version": "0.0.0",
  "description": "Tipos, rutas y utilidades sin UI de la librería de front de CallePuzzle",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/CallePuzzle/storybook-svelte.git",
    "directory": "packages/core"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com",
    "access": "public"
  },
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist",
    "!dist/**/*.test.*",
    "!dist/**/*.spec.*"
  ],
  "types": "./dist/index.d.ts",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "source": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "dev": "paraglide-js compile --project ./project.inlang --outdir ./src/paraglide && tsup --watch",
    "build": "paraglide-js compile --project ./project.inlang --outdir ./src/paraglide && tsup",
    "lint": "eslint . --max-warnings 0",
    "prepack": "bun run build && publint",
    "check-publish": "bun run build && publint && attw --pack . --profile esm-only"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.2",
    "@callepuzzle/typescript-config": "*",
    "@inlang/paraglide-js": "^2.2.0",
    "@repo/eslint-config": "*",
    "eslint": "^9.32.0",
    "publint": "^0.3.12",
    "tsup": "^8.0.0",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4"
  }
}
