# URL que usa el cliente en tiempo de ejecución (adaptador libSQL/Turso).
# En local, `turso dev --db-file dev.db` sirve dev.db por HTTP en este puerto.
LIBSQL_URL="http://127.0.0.1:8080"

# URL que usa la CLI de Prisma (migrate / db push / studio). Para SQLite tiene que ser
# `file:`, y se resuelve relativa a prisma/schema.prisma.
DATABASE_URL="file:../../../dev.db"

# Secreto con el que better-auth firma las cookies de sesión. Mínimo 32 caracteres; genera uno
# con `openssl rand -base64 32`. Vacío a propósito: un valor de ejemplo copiado tal cual es un
# secreto público. En `vite dev` el demo usa uno de desarrollo si falta; fuera de él,
# `betterAuthHandle` no atiende peticiones sin secreto.
BETTER_AUTH_SECRET=""

# URL pública de la app. Obligatoria fuera de desarrollo: sin ella better-auth deduce la URL de
# los magic links de las cabeceras X-Forwarded-* de cada petición, que puede inventarse cualquiera.
# En `vite dev` el demo usa http://localhost:5173 si falta.
BETTER_AUTH_URL="http://localhost:5173"
