{
	"name": "sveltekit",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"scripts": {
		"dev": "prisma generate && vite dev",
		"build": "prisma generate && vite build",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"paraglide:compile": "paraglide-js compile --project ./project.inlang --outdir ./src/lib/paraglide --strategy cookie baseLocale",
		"check": "bun run paraglide:compile && svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "bun run paraglide:compile && svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"check-types": "bun run paraglide:compile && svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"lint": "oxlint --config ../../.oxlintrc.json .",
		"test": "playwright test",
		"test:e2e": "playwright test",
		"test:e2e:ui": "playwright test --ui",
		"db:generate": "prisma generate",
		"db:migrate:deploy": "prisma migrate deploy",
		"db:migrate:dev": "prisma migrate dev",
		"db:push": "prisma db push",
		"studio": "prisma studio",
		"better-auth:generate": "bunx @better-auth/cli@latest generate -y --config ./src/lib/server/auth.ts"
	},
	"dependencies": {
		"@callepuzzle/auth": "workspace:*",
		"@callepuzzle/core": "workspace:*",
		"@callepuzzle/svelte-ui": "workspace:*",
		"@lucide/svelte": "^0.488.0",
		"@prisma/adapter-libsql": "^6.12.0",
		"@prisma/client": "^6.12.0",
		"better-auth": "^1.3.4",
		"bits-ui": "^2.19.0",
		"formsnap": "^2.0.1",
		"sveltekit-superforms": "^2.27.1",
		"zod": "^3.25.76"
	},
	"devDependencies": {
		"@callepuzzle/typescript-config": "workspace:*",
		"@inlang/paraglide-js": "^2.2.0",
		"@playwright/test": "^1.62.1",
		"@sveltejs/adapter-auto": "^6.0.1",
		"@sveltejs/kit": "^2.27.0",
		"@sveltejs/vite-plugin-svelte": "^6.1.0",
		"@tailwindcss/vite": "^4.1.11",
		"daisyui": "^5.0.50",
		"prisma": "^6.12.0",
		"svelte": "^5.37.2",
		"svelte-check": "^4.3.0",
		"tailwindcss": "^4.1.11",
		"typescript": "5.9.2",
		"vite": "^7.0.6"
	}
}
