{
  "name": "callepuzzle-frontend-library",
  "private": true,
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "dev:sveltekit": "turbo run dev --filter=sveltekit...",
    "lint": "turbo run lint",
    "format": "prettier --write \"**/*.{ts,tsx,md,svelte,astro}\"",
    "check-types": "turbo run check-types",
    "storybook": "turbo run storybook",
    "db:generate": "turbo run db:generate",
    "db:migrate:deploy": "turbo run db:migrate:deploy",
    "db:migrate:dev": "turbo run db:migrate:dev",
    "db:push": "turbo run db:push",
    "better-auth:generate": "turbo run better-auth:generate",
    "check-publish": "turbo run check-publish",
    "changeset": "changeset",
    "version-packages": "changeset version",
    "release": "turbo run build --filter=@callepuzzle/* && changeset publish"
  },
  "devDependencies": {
    "@changesets/cli": "^3.0.1",
    "prettier": "^3.6.2",
    "turbo": "^2.5.5",
    "typescript": "5.8.3"
  },
  "engines": {
    "node": ">=18"
  },
  "packageManager": "bun@1.3.14",
  "workspaces": [
    "demos/*",
    "packages/*"
  ]
}
