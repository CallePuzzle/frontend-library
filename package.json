{
	"name": "callepuzzle-frontend-library",
	"private": true,
	"type": "module",
	"scripts": {
		"build": "turbo run build",
		"build-storybook": "turbo run build-storybook",
		"dev": "turbo run dev",
		"dev:sveltekit": "turbo run dev --filter=sveltekit...",
		"storybook": "turbo run storybook",
		"lint": "turbo run lint",
		"lint:fix": "oxlint --config .oxlintrc.json --fix",
		"check": "turbo run check",
		"check-types": "turbo run check-types",
		"check-publish": "turbo run check-publish",
		"test": "turbo run test",
		"format": "prettier --write .",
		"format:ci": "prettier --check .",
		"prepush": "bun run format:ci && turbo run lint check-types test build",
		"hooks:install": "simple-git-hooks",
		"postinstall": "[ -n \"$SKIP_INSTALL_SIMPLE_GIT_HOOKS\" ] || simple-git-hooks || true",
		"changeset": "changeset",
		"version-packages": "changeset version",
		"release": "turbo run build --filter=@callepuzzle/* && changeset publish"
	},
	"simple-git-hooks": {
		"pre-commit": "bunx lint-staged",
		"pre-push": "bun run prepush"
	},
	"lint-staged": {
		"**/*.{js,mjs,cjs,jsx,ts,mts,cts,tsx,svelte}": "oxlint --config .oxlintrc.json",
		"**/*.{js,mjs,cjs,jsx,ts,mts,cts,tsx,svelte,css,json,md,yml,yaml}": "prettier --write"
	},
	"devDependencies": {
		"@changesets/cli": "^3.0.1",
		"lint-staged": "^17.4.1",
		"oxlint": "^1.81.0",
		"prettier": "^3.6.2",
		"prettier-plugin-svelte": "^3.4.0",
		"prettier-plugin-tailwindcss": "^0.6.14",
		"simple-git-hooks": "^2.14.0",
		"turbo": "^2.5.5",
		"typescript": "5.9.2"
	},
	"engines": {
		"node": ">=22",
		"bun": ">=1.3.0"
	},
	"packageManager": "bun@1.3.14",
	"workspaces": [
		"demos/*",
		"packages/*"
	]
}
