# Registro de GitHub Packages para el scope @callepuzzle.
# El token NUNCA se commitea: se toma de la variable de entorno NPM_TOKEN.
# Local:  export NPM_TOKEN=<PAT con scope read:packages (write:packages para publicar)>
# CI:     NPM_TOKEN=${{ secrets.GITHUB_TOKEN }}
@callepuzzle:registry=https://npm.pkg.github.com
//npm.pkg.github.com/:_authToken=${NPM_TOKEN}
